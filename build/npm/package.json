  ],
  "homepage": "https://github.com/AngelMsger/jenkins-cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AngelMsger/jenkins-cli.git"
  },
  "license": "MIT",
  "bin": {
    "jenkins-cli": "bin/jenkins-cli.js"
  },
  "main": "install.js",
  "scripts": {
    "postinstall": "node install.js"
  },
  "files": [
    "bin/",
    "install.js",
    "README.md"
  ],
