# jenkins-cli environment configuration
# Copy to .env and fill in. All variables are optional and overridable by CLI flags.

# Jenkins server URL (e.g. http://localhost:8080 or https://jenkins.example.com)
JENKINS_URL=http://localhost:8080

# Jenkins username the credential belongs to
JENKINS_USER=

# --- Authentication: pick ONE secret ---

# Recommended: a Jenkins API token (User -> Configure -> API Token)
JENKINS_TOKEN=

# Or your Jenkins password (basic auth)
JENKINS_PASSWORD=

# Default output format: json | table | ndjson
JENKINS_FORMAT=json

# Session read-only posture (1 to block writes before they leave the CLI)
JENKINS_CLI_READ_ONLY=

# Set to 1 to silence the "a newer release is available" notice on stderr
JENKINS_CLI_NO_UPDATE_NOTIFIER=
